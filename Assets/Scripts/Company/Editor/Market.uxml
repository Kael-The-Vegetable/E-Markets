<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <ui:Label text="Market" name="Title" style="-unity-text-align: upper-center; font-size: 30px; -unity-font-style: bold;" />
    <ui:TextField label="Name&#x9;" placeholder-text="filler text" name="Name" binding-path="Name" style="margin-left: 3px; padding-left: 0; padding-right: 0;" />
    <ui:TextField label="Description" placeholder-text="filler text" binding-path="Description" multiline="true" style="align-items: flex-start; justify-content: flex-start; align-self: stretch; flex-direction: row; min-height: 50px;" />
    <uie:PropertyField binding-path="Name" label="Name" />
</ui:UXML>
